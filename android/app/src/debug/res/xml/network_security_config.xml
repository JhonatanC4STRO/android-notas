<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo para builds debug: permite HTTP sin cifrar hacia el backend local
    (10.0.2.2 = "localhost" del host visto desde el emulador). Los builds
    de release no incluyen este archivo, asi que mantienen el bloqueo de
    trafico en texto plano por defecto de Android.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
